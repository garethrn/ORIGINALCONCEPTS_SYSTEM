APP_NAME="Original Concepts Support"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://support.originalconcepts.co.za
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oc_support
DB_USERNAME=oc_support
# SECRET — database password for the oc-support MySQL user
DB_PASSWORD=
# SECRET — MySQL root password, used only inside the oc-support compose project
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset so the cookie is Secure only when the reverse proxy marks the request HTTPS.
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# SECRET — SMTP password
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=mail.originalconcepts.co.za
MAIL_PORT=587
MAIL_USERNAME=support@originalconcepts.co.za
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@originalconcepts.co.za
MAIL_FROM_NAME="${APP_NAME}"

# Host port published on 127.0.0.1 only. Do not change the bind address in docker-compose.prod.yml.
APP_BIND_PORT=8085

# Trust the local reverse proxy so HTTPS and client IP are detected. The app is not reachable except via 127.0.0.1.
TRUSTED_PROXIES=*

# AI assistant. Leave AI_API_KEY empty to disable the assistant. Do not set AI_DRIVER=fake in production.
AI_DRIVER=openai
# SECRET
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

VITE_APP_NAME="${APP_NAME}"
